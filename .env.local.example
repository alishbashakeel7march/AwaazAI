# ============================================================
# AwaazAI — Environment Variables
# Copy this file to .env.local and fill in your keys.
# The app works WITHOUT any keys (demo mode) — add keys to
# unlock live speech recognition and real AI answers.
# ============================================================

# --- Speech-to-Text (Groq Whisper) — https://console.groq.com ---
# Free tier available. Used by /api/stt for voice transcription.
GROQ_API_KEY=

# --- AI Answering (choose ONE provider) ---
# Option A: Alibaba Cloud ModelStudio / DashScope (Qwen) — https://modelstudio.alibaba.com
AI_API_KEY=
AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus

# Option B: Groq LLM (uses the same GROQ_API_KEY as above)
# If AI_API_KEY is empty but GROQ_API_KEY is set, the app
# automatically uses Groq llama-3.3-70b-versatile.

# --- Supabase (admin analytics) — https://supabase.com ---
# Free tier. Create a project, run the SQL from README.md,
# then paste the values from Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin dashboard password (/admin) ---
# Defaults to "awaaz2026" if unset.
ADMIN_PASSWORD=
